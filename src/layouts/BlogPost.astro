---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MastodonWidget from '../components/MastodonWidget.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	slug?: string;
	filePath?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	lastUpdatedDate,
	heroImage,
	mastodonTootId,
	slug,
	filePath,
} = Astro.props;

const displayUpdatedDate = lastUpdatedDate || updatedDate;

// 构造文章在 GitHub 上的历史提交记录页面链接
const cleanPath = filePath ? filePath.replace(/\\/g, '/') : (slug ? `src/content/blog/${slug}.md` : '');
const historyUrl = cleanPath ? `https://github.com/dustyat/blog/commits/main/${cleanPath}` : null;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<!-- Reading Progress Bar -->
		<div id="progress-bar" class="progress-bar"></div>

		<Header />
		<main>
			<article class="article-container">
				<!-- Navigation Back -->
				<div class="back-nav">
					<a href="/blog" class="back-link">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="m15 18-6-6 6-6"/>
						</svg>
						返回文章列表
					</a>
				</div>

				<!-- Article Header -->
				<header class="article-header">
					<div class="article-meta">
						<span class="meta-item">
							<FormattedDate date={pubDate} />
						</span>
						{
							displayUpdatedDate && (
								<span class="meta-item updated">
									(最后更新于 <FormattedDate date={displayUpdatedDate} />)
								</span>
							)
						}
						{
							historyUrl && (
								<a
									href={historyUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="meta-item history-badge"
									title="在 GitHub 上查看此文章的历史修改记录与版本变化"
								>
									<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10"/>
										<polyline points="12 6 12 12 16 14"/>
									</svg>
									<span>版本历史</span>
								</a>
							)
						}
					</div>
					<h1 class="article-title">{title}</h1>
					{description && <p class="article-desc">{description}</p>}
				</header>

				<!-- Hero Image (if available) -->
				{
					heroImage && (
						<div class="hero-image-wrapper">
							<Image width={1020} height={510} src={heroImage} alt={title} class="hero-img" />
						</div>
					)
				}

				<!-- Article Content -->
				<div class="prose content-body">
					<slot />
				</div>

				<!-- Article Footer Revision Info -->
				{
					historyUrl && (
						<footer class="article-footer-info">
							<div class="revision-box">
								<div class="revision-meta">
									<span class="revision-label">版本追溯</span>
									<span class="revision-desc">
										本文已纳入 Git 版本控制。可随时查阅历次修改说明与完整段落比对。
									</span>
								</div>
								<a
									href={historyUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="history-btn"
								>
									<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10"/>
										<polyline points="12 6 12 12 16 14"/>
									</svg>
									<span>查看修改历史 (Commits)</span>
									<span class="btn-arrow">↗</span>
								</a>
							</div>
						</footer>
					)
				}
			</article>
		</main>
		<Footer />

		<!-- Mastodon Peeking Widget & Non-blocking Floating Card -->
		<MastodonWidget tootId={mastodonTootId} />

		<script>
			// Reading Progress Bar
			window.addEventListener('scroll', () => {
				const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
				const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				const scrolled = (winScroll / height) * 100;
				const bar = document.getElementById('progress-bar');
				if (bar) bar.style.width = scrolled + '%';
			});

			// Code Block Copy Button
			document.querySelectorAll('pre').forEach((pre) => {
				const button = document.createElement('button');
				button.className = 'copy-code-btn';
				button.innerText = 'Copy';
				button.addEventListener('click', async () => {
					const code = pre.querySelector('code')?.innerText || pre.innerText;
					await navigator.clipboard.writeText(code);
					button.innerText = 'Copied!';
					setTimeout(() => {
						button.innerText = 'Copy';
					}, 2000);
				});
				pre.appendChild(button);
			});
		</script>
	</body>
</html>

<style>
	.progress-bar {
		position: fixed;
		top: 0;
		left: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--accent), #a855f7);
		width: 0%;
		z-index: 100;
		transition: width 0.1s ease-out;
	}

	.article-container {
		max-width: 760px;
		margin: 0 auto;
	}

	.back-nav {
		margin-bottom: 2rem;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--text-muted);
		padding: 0.35rem 0.75rem;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-full);
		transition: all 0.2s ease;
	}

	.back-link:hover {
		color: var(--accent);
		border-color: var(--accent);
		transform: translateX(-2px);
	}

	.article-header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border-color);
	}

	.article-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		margin-bottom: 0.75rem;
	}

	.history-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.15rem 0.55rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--text-muted);
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-full);
		text-decoration: none !important;
		transition: all 0.2s ease;
		margin-left: 0.2rem;
	}

	.history-badge:hover {
		color: var(--accent);
		border-color: var(--accent);
		background: var(--card-hover);
		transform: translateY(-1px);
	}

	.article-title {
		font-size: 2.5rem;
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.2;
		margin: 0 0 1rem 0;
	}

	.article-desc {
		font-size: 1.15rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
	}

	.hero-image-wrapper {
		margin: 2rem 0 3rem;
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--border-color);
		box-shadow: var(--shadow-md);
	}

	.hero-img {
		width: 100%;
		height: auto;
		display: block;
	}

	.content-body {
		margin-bottom: 2rem;
	}

	.article-footer-info {
		margin: 2rem 0 3.5rem;
		padding-top: 1.5rem;
		border-top: 1px dashed var(--border-color);
	}

	.revision-box {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		padding: 1rem 1.25rem;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.revision-box:hover {
		border-color: var(--accent);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
	}

	.revision-meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		flex: 1;
		min-width: 240px;
	}

	.revision-label {
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--accent);
	}

	.revision-desc {
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.history-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 0.95rem;
		font-size: 0.825rem;
		font-weight: 600;
		color: var(--text-color) !important;
		background: var(--card-hover);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-sm);
		text-decoration: none !important;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.history-btn:hover {
		color: var(--accent) !important;
		border-color: var(--accent);
		transform: translateY(-1px);
	}

	.btn-arrow {
		font-size: 0.95rem;
		transition: transform 0.2s ease;
	}

	.history-btn:hover .btn-arrow {
		transform: translate(2px, -2px);
	}

	:global(.copy-code-btn) {
		position: absolute;
		top: 0.6rem;
		right: 0.6rem;
		padding: 0.25rem 0.55rem;
		font-size: 0.75rem;
		font-family: var(--font-sans);
		font-weight: 600;
		background: rgba(255, 255, 255, 0.1);
		color: #e4e4e7;
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 6px;
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.2s ease, background-color 0.2s ease;
	}

	:global(pre:hover .copy-code-btn) {
		opacity: 1;
	}

	:global(.copy-code-btn:hover) {
		background: rgba(255, 255, 255, 0.2);
	}

	@media (max-width: 640px) {
		.article-title {
			font-size: 1.85rem;
		}
		.article-desc {
			font-size: 1rem;
		}
	}
</style>
