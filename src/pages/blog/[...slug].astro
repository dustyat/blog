---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPostDescription, getPostHeroImage, getPostTags } from '../../utils/post';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const effectiveDescription = getPostDescription(post);
const effectiveHeroImage = getPostHeroImage(post);
const effectiveTags = getPostTags(post);
const hasExplicitHeroImage = Boolean(post.data.heroImage);
---

<BlogPost
	{...post.data}
	description={effectiveDescription}
	heroImage={effectiveHeroImage}
	tags={effectiveTags}
	slug={post.id}
	filePath={post.filePath}
	hasExplicitHeroImage={hasExplicitHeroImage}
>
	<Content />
</BlogPost>
