---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group posts by year for timeline
const postsByYear = posts.reduce((acc, post) => {
	const year = post.data.pubDate.getFullYear();
	if (!acc[year]) acc[year] = [];
	acc[year].push(post);
	return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章归档 · ${SITE_TITLE}`} description="所有技术文章与思考的时间线归档" />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<h1 class="page-title">文章归档</h1>
				<p class="page-desc">按时间顺序索引的所有文章（共 {posts.length} 篇）</p>
			</header>

			<section class="timeline-section">
				<div class="timeline">
					{years.map((year) => (
						<div class="timeline-year-group">
							<div class="timeline-year-badge">{year}</div>
							<div class="timeline-items">
								{postsByYear[year].map((post) => (
									<article class="timeline-item">
										<div class="timeline-node">
											<span class="timeline-dot"></span>
										</div>
										<div class="timeline-content">
											<div class="timeline-date">
												<FormattedDate date={post.data.pubDate} />
											</div>
											<h2 class="timeline-post-title">
												<a href={`/blog/${post.id}/`}>{post.data.title}</a>
											</h2>
											{post.data.description && (
												<p class="timeline-post-desc">{post.data.description}</p>
											)}
										</div>
									</article>
								))}
							</div>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		padding: 1.5rem 0 2rem;
		border-bottom: 1px solid var(--border-color);
		margin-bottom: 2.5rem;
	}

	.page-title {
		font-size: 2rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		margin: 0 0 0.5rem 0;
	}

	.page-desc {
		font-size: 1rem;
		color: var(--text-muted);
		margin: 0;
	}

	.timeline {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.timeline-year-group {
		position: relative;
	}

	.timeline-year-badge {
		font-size: 1.1rem;
		font-weight: 700;
		font-family: var(--font-mono);
		color: var(--text-muted);
		margin-bottom: 1.25rem;
		padding-left: 0.25rem;
	}

	.timeline-items {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		padding-left: 1.5rem;
		border-left: 2px solid var(--timeline-line);
		margin-left: 0.5rem;
	}

	.timeline-item {
		position: relative;
		display: flex;
		flex-direction: column;
	}

	.timeline-node {
		position: absolute;
		left: -1.5rem;
		top: 0.35rem;
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: var(--bg-color);
		padding: 3px 0;
	}

	.timeline-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: var(--text-subtle);
		transition: all 0.2s ease;
	}

	.timeline-item:hover .timeline-dot {
		background-color: var(--accent);
		transform: scale(1.4);
		box-shadow: 0 0 8px var(--accent);
	}

	.timeline-content {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.timeline-date {
		font-size: 0.8rem;
		font-family: var(--font-mono);
		color: var(--text-muted);
	}

	.timeline-post-title {
		font-size: 1.15rem;
		font-weight: 600;
		margin: 0;
		line-height: 1.4;
	}

	.timeline-post-title a {
		color: var(--text-color);
		transition: color 0.15s ease;
	}

	.timeline-post-title a:hover {
		color: var(--accent);
	}

	.timeline-post-desc {
		font-size: 0.9rem;
		color: var(--text-muted);
		margin: 0;
		line-height: 1.5;
	}
</style>
