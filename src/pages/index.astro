---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPostDescription, getPostHeroImageUrl, getPostTags } from '../utils/post';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group posts by year for timeline
const postsByYear = posts.reduce((acc, post) => {
	const year = post.data.pubDate.getFullYear();
	if (!acc[year]) acc[year] = [];
	acc[year].push(post);
	return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="sr-only">{SITE_TITLE} - {SITE_DESCRIPTION}</h1>

			<!-- Timeline of Articles -->
			<section class="timeline-section">
				<!-- Tag Filter Bar (Dynamic Client-side) -->
				<div id="tag-filter-bar" class="tag-filter-bar" style="display: none;">
					<div class="filter-info">
						<span class="filter-dot"></span>
						<span>当前筛选标签：<strong id="filter-tag-name"></strong></span>
					</div>
					<button id="clear-filter-btn" type="button" class="clear-filter-btn" title="查看全部文章">
						<span>清除筛选</span>
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
					</button>
				</div>
				<div id="no-tag-results" class="no-tag-results" style="display: none;">
					<p>未找到该标签下的相关文章</p>
					<button type="button" class="clear-filter-btn" id="reset-filter-btn">查看全部文章</button>
				</div>

				<div class="timeline">
					{years.map((year, index) => {
						const yearPosts = postsByYear[year];
						const isLatestYear = index === 0;
						return (
							<div
								class={`timeline-year-group ${isLatestYear ? 'is-expanded' : 'is-collapsed'}`}
								data-year={year}
								data-default-expanded={isLatestYear ? 'true' : 'false'}
							>
								<button
									type="button"
									class="timeline-year-header"
									aria-expanded={isLatestYear ? 'true' : 'false'}
									title={isLatestYear ? '点击收起该年份' : '点击展开该年份'}
								>
									<div class="year-header-left">
										<span class="timeline-year-badge">{year}</span>
										<span class="timeline-year-count">{yearPosts.length} 篇</span>
									</div>
									<div class="year-header-right">
										<svg class="year-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
											<polyline points="6 9 12 15 18 9"></polyline>
										</svg>
									</div>
								</button>
								<div class="timeline-items">
									{yearPosts.map((post) => {
										const heroImgUrl = getPostHeroImageUrl(post);
										const desc = getPostDescription(post);
										const tags = getPostTags(post);
										return (
											<article class="timeline-item" data-tags={tags.map(t => t.toLowerCase()).join(',')}>
												<div class="timeline-content">
													<div class="timeline-date">
														<FormattedDate date={post.data.pubDate} />
													</div>
													{heroImgUrl && (
														<a
															href={`/blog/${post.id}/`}
															class="timeline-cover-link"
															aria-label={post.data.title}
														>
															<img
																src={heroImgUrl}
																alt={post.data.title}
																class="timeline-cover-img"
																loading="lazy"
															/>
														</a>
													)}
													<h3 class="timeline-post-title">
														<a href={`/blog/${post.id}/`}>{post.data.title}</a>
													</h3>
													{desc && <p class="timeline-post-desc">{desc}</p>}
													{tags.length > 0 && (
														<div class="timeline-tags">
															{tags.map((tag) => (
																<button
																	type="button"
																	class="timeline-tag"
																	data-tag={tag}
																	title={`按标签 #${tag} 筛选`}
																>
																	#{tag}
																</button>
															))}
														</div>
													)}
												</div>
											</article>
										);
									})}
								</div>
							</div>
						);
					})}
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// 年份折叠/展开交互
			const setupYearToggles = () => {
				const yearHeaders = document.querySelectorAll<HTMLButtonElement>('.timeline-year-header');
				yearHeaders.forEach((btn) => {
					btn.addEventListener('click', () => {
						const group = btn.closest<HTMLElement>('.timeline-year-group');
						if (!group) return;
						const isExpanded = group.classList.contains('is-expanded');
						if (isExpanded) {
							group.classList.remove('is-expanded');
							group.classList.add('is-collapsed');
							btn.setAttribute('aria-expanded', 'false');
							btn.setAttribute('title', '点击展开该年份');
						} else {
							group.classList.remove('is-collapsed');
							group.classList.add('is-expanded');
							btn.setAttribute('aria-expanded', 'true');
							btn.setAttribute('title', '点击收起该年份');
						}
					});
				});
			};

			setupYearToggles();

			const filterByTag = (tagName: string | null) => {
				const cleanTag = (tagName || '').trim().toLowerCase();
				const filterBar = document.getElementById('tag-filter-bar');
				const filterTagName = document.getElementById('filter-tag-name');
				const noResults = document.getElementById('no-tag-results');
				const articles = document.querySelectorAll<HTMLElement>('.timeline-item');
				const yearGroups = document.querySelectorAll<HTMLElement>('.timeline-year-group');
				const tagButtons = document.querySelectorAll<HTMLElement>('.timeline-tag');

				if (!cleanTag) {
					if (filterBar) filterBar.style.display = 'none';
					if (noResults) noResults.style.display = 'none';
					articles.forEach((art) => (art.style.display = ''));
					
					// 恢复默认年份折叠状态 (首年展开，往年折叠)
					yearGroups.forEach((yg) => {
						yg.style.display = '';
						const defaultExpanded = yg.getAttribute('data-default-expanded') === 'true';
						const btn = yg.querySelector<HTMLButtonElement>('.timeline-year-header');
						if (defaultExpanded) {
							yg.classList.add('is-expanded');
							yg.classList.remove('is-collapsed');
							btn?.setAttribute('aria-expanded', 'true');
						} else {
							yg.classList.remove('is-expanded');
							yg.classList.add('is-collapsed');
							btn?.setAttribute('aria-expanded', 'false');
						}
					});
					tagButtons.forEach((btn) => btn.classList.remove('active'));

					const url = new URL(window.location.href);
					if (url.searchParams.has('tag')) {
						url.searchParams.delete('tag');
						window.history.replaceState({}, '', url.pathname);
					}
					return;
				}

				let totalVisible = 0;
				if (filterBar) {
					filterBar.style.display = 'flex';
					if (filterTagName) filterTagName.textContent = '#' + tagName;
				}

				articles.forEach((art) => {
					const tags = (art.getAttribute('data-tags') || '').split(',');
					if (tags.includes(cleanTag)) {
						art.style.display = '';
						totalVisible++;
					} else {
						art.style.display = 'none';
					}
				});

				// 筛选激活时，有匹配项的年份自动展开并显示
				yearGroups.forEach((yg) => {
					const visible = yg.querySelectorAll<HTMLElement>('.timeline-item:not([style*="display: none"])');
					if (visible.length > 0) {
						yg.style.display = '';
						yg.classList.add('is-expanded');
						yg.classList.remove('is-collapsed');
						const btn = yg.querySelector<HTMLButtonElement>('.timeline-year-header');
						btn?.setAttribute('aria-expanded', 'true');
					} else {
						yg.style.display = 'none';
					}
				});

				if (noResults) {
					noResults.style.display = totalVisible === 0 ? 'block' : 'none';
				}

				tagButtons.forEach((btn) => {
					const btnTag = (btn.getAttribute('data-tag') || '').toLowerCase();
					btn.classList.toggle('active', btnTag === cleanTag);
				});

				const url = new URL(window.location.href);
				url.searchParams.set('tag', tagName || '');
				window.history.replaceState({}, '', url.toString());
			};

			// Initialize filter from URL parameter
			const currentParams = new URLSearchParams(window.location.search);
			const initialTag = currentParams.get('tag');
			if (initialTag) {
				filterByTag(initialTag);
			}

			// Tag click handling (toggle filter or switch)
			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				const tagBtn = target.closest('.timeline-tag') as HTMLElement | null;
				if (tagBtn) {
					e.preventDefault();
					const clickedTag = tagBtn.getAttribute('data-tag');
					const currentTag = new URLSearchParams(window.location.search).get('tag');
					if (currentTag && currentTag.toLowerCase() === (clickedTag || '').toLowerCase()) {
						filterByTag(null);
					} else {
						filterByTag(clickedTag);
					}
				} else if (target.closest('#clear-filter-btn') || target.closest('#reset-filter-btn')) {
					e.preventDefault();
					filterByTag(null);
				}
			});
		</script>
	</body>
</html>

<style>
	.timeline-section {
		padding-top: 0.25rem;
	}

	.timeline {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.timeline-year-group {
		position: relative;
	}

	.timeline-year-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		background: transparent;
		border: none;
		padding: 0.4rem 0.25rem;
		margin-bottom: 1.25rem;
		cursor: pointer;
		color: inherit;
		border-radius: var(--radius-sm);
		transition: background-color 0.15s ease, opacity 0.15s ease;
		text-align: left;
	}

	.timeline-year-header:hover {
		background: var(--card-hover);
	}

	.year-header-left {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
	}

	.timeline-year-badge {
		font-size: 1.2rem;
		font-weight: 700;
		font-family: var(--font-mono);
		color: var(--text-color);
		letter-spacing: -0.01em;
	}

	.timeline-year-count {
		font-size: 0.75rem;
		font-family: var(--font-mono);
		color: var(--text-muted);
		background: var(--card-hover);
		border: 1px solid var(--border-subtle);
		padding: 0.12rem 0.5rem;
		border-radius: 999px;
		line-height: 1.2;
	}

	.year-header-right {
		display: inline-flex;
		align-items: center;
		color: var(--text-muted);
	}

	.year-chevron {
		transition: transform 0.25s ease, color 0.15s ease;
	}

	.timeline-year-header:hover .year-chevron {
		color: var(--text-color);
	}

	/* 展开时：箭头向下 */
	.timeline-year-group.is-expanded .year-chevron {
		transform: rotate(0deg);
	}

	/* 折叠时：箭头指向左/右 (向右表示可展开) */
	.timeline-year-group.is-collapsed .year-chevron {
		transform: rotate(-90deg);
	}

	/* 折叠时：内容隐藏，底部留白缩减 */
	.timeline-year-group.is-collapsed .timeline-items {
		display: none;
	}

	.timeline-year-group.is-collapsed {
		margin-bottom: 0.5rem;
	}

	.timeline-items {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 2.75rem;
		padding-left: 0;
		margin-left: 0;
		border-left: none;
	}

	.timeline-item {
		position: relative;
		display: flex;
		flex-direction: column;
	}

	@media (max-width: 640px) {
		.timeline-items {
			padding-left: 0;
			margin-left: 0;
			border-left: none;
			gap: 2rem;
		}

		.timeline-year-badge {
			font-size: 1.1rem;
		}

		.timeline-year-header {
			margin-bottom: 0.85rem;
		}
	}

	/* Dynamic Tag Filter Bar */
	.tag-filter-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		background: var(--card-hover);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-md);
		padding: 0.45rem 0.85rem;
		margin-bottom: 1.5rem;
		font-size: 0.85rem;
	}

	.filter-info {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-color);
	}

	.filter-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
	}

	.clear-filter-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		background: transparent;
		border: 1px solid var(--border-subtle);
		color: var(--text-muted);
		border-radius: var(--radius-sm);
		padding: 0.15rem 0.55rem;
		font-size: 0.78rem;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.clear-filter-btn:hover {
		color: var(--accent);
		border-color: var(--accent);
		background: var(--bg-surface);
	}

	.no-tag-results {
		text-align: center;
		padding: 3rem 1.5rem;
		color: var(--text-muted);
		background: var(--card-hover);
		border-radius: var(--radius-md);
		border: 1px dashed var(--border-subtle);
		margin-bottom: 2rem;
	}

	.no-tag-results p {
		margin-bottom: 0.75rem;
	}

	.timeline-content {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.timeline-cover-link {
		width: 100%;
		height: 240px;
		max-height: 260px;
		border-radius: var(--radius-md, 8px);
		overflow: hidden;
		border: 1px solid var(--border-subtle);
		background-color: var(--card-hover);
		display: block;
		box-shadow: var(--shadow-sm);
		margin: 0.25rem 0 0.15rem;
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}

	.timeline-cover-link:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	.timeline-cover-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}

	.timeline-cover-link:hover .timeline-cover-img {
		transform: scale(1.025);
	}

	@media (max-width: 640px) {
		.timeline-cover-link {
			height: 180px;
		}
	}

	.timeline-date {
		font-size: 0.8rem;
		font-family: var(--font-mono);
		color: var(--text-muted);
	}

	.timeline-post-title {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0.2rem 0 0;
		line-height: 1.4;
	}

	.timeline-post-title a {
		color: var(--text-color);
		transition: color 0.15s ease;
	}

	.timeline-post-title a:hover {
		color: var(--accent);
	}

	.timeline-post-desc {
		font-size: 0.9rem;
		color: var(--text-muted);
		margin: 0;
		line-height: 1.5;
	}

	.timeline-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.25rem;
	}

	.timeline-tag {
		display: inline-flex;
		align-items: center;
		cursor: pointer;
		font-size: 0.725rem;
		font-family: var(--font-mono);
		color: var(--text-muted);
		background: var(--card-hover);
		padding: 0.12rem 0.45rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border-subtle);
		outline: none;
		line-height: 1.3;
		transition: all 0.15s ease;
	}

	.timeline-tag:hover {
		color: var(--accent);
		border-color: var(--accent);
		transform: translateY(-1px);
	}

	.timeline-tag.active {
		color: var(--accent);
		border-color: var(--accent);
		background: rgba(9, 105, 218, 0.1);
		font-weight: 600;
	}

	/* ================= 紧凑视图模式 (Compact Mode) ================= */
	:global(html[data-view="compact"]) .timeline {
		gap: 1.75rem;
	}

	:global(html[data-view="compact"]) .timeline-items {
		gap: 0.45rem;
	}

	:global(html[data-view="compact"]) .timeline-cover-link,
	:global(html[data-view="compact"]) .timeline-post-desc {
		display: none !important;
	}

	:global(html[data-view="compact"]) .timeline-item {
		padding: 0.45rem 0.6rem;
		border-radius: var(--radius-sm);
		transition: background-color 0.15s ease;
	}

	:global(html[data-view="compact"]) .timeline-item:hover {
		background: var(--card-hover);
	}

	:global(html[data-view="compact"]) .timeline-content {
		display: flex;
		flex-direction: row;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	:global(html[data-view="compact"]) .timeline-date {
		flex-shrink: 0;
		width: 88px;
		font-size: 0.82rem;
		color: var(--text-muted);
	}

	:global(html[data-view="compact"]) .timeline-post-title {
		flex: 1 1 auto;
		font-size: 1rem;
		font-weight: 600;
		margin: 0;
		line-height: 1.4;
	}

	:global(html[data-view="compact"]) .timeline-tags {
		margin-top: 0;
		margin-left: auto;
		gap: 0.25rem;
	}

	:global(html[data-view="compact"]) .timeline-tag {
		font-size: 0.7rem;
		padding: 0.05rem 0.35rem;
	}

	@media (max-width: 640px) {
		:global(html[data-view="compact"]) .timeline-content {
			flex-direction: column;
			gap: 0.25rem;
		}

		:global(html[data-view="compact"]) .timeline-date {
			width: auto;
			font-size: 0.75rem;
		}

		:global(html[data-view="compact"]) .timeline-tags {
			margin-left: 0;
		}
	}
</style>
