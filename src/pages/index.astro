---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPostDescription, getPostHeroImageUrl, getPostTags } from '../utils/post';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group posts by year for timeline
const postsByYear = posts.reduce((acc, post) => {
	const year = post.data.pubDate.getFullYear();
	if (!acc[year]) acc[year] = [];
	acc[year].push(post);
	return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Simple Intro -->
			<section class="intro-section">
				<h1 class="intro-title">DUSTY的手记 👋</h1>
				<p class="intro-desc">
					记录思考、架构演进与技术实践。
				</p>
			</section>

			<!-- Timeline of Articles -->
			<section class="timeline-section">
				<div class="timeline">
					{years.map((year) => (
						<div class="timeline-year-group">
							<div class="timeline-year-badge">{year}</div>
							<div class="timeline-items">
								{postsByYear[year].map((post) => {
									const heroImgUrl = getPostHeroImageUrl(post);
									const desc = getPostDescription(post);
									const tags = getPostTags(post);
									return (
										<article class="timeline-item">
											<div class="timeline-node">
												<span class="timeline-dot"></span>
											</div>
											<div class="timeline-content">
												<div class="timeline-date">
													<FormattedDate date={post.data.pubDate} />
												</div>
												{heroImgUrl && (
													<a
														href={`/blog/${post.id}/`}
														class="timeline-cover-link"
														aria-label={post.data.title}
													>
														<img
															src={heroImgUrl}
															alt={post.data.title}
															class="timeline-cover-img"
															loading="lazy"
														/>
													</a>
												)}
												<h3 class="timeline-post-title">
													<a href={`/blog/${post.id}/`}>{post.data.title}</a>
												</h3>
												{desc && <p class="timeline-post-desc">{desc}</p>}
												{tags.length > 0 && (
													<div class="timeline-tags">
														{tags.map((tag) => (
															<span class="timeline-tag">#{tag}</span>
														))}
													</div>
												)}
											</div>
										</article>
									);
								})}
							</div>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro-section {
		padding: 1.5rem 0 2.5rem;
		border-bottom: 1px solid var(--border-subtle);
		margin-bottom: 2.5rem;
	}

	.intro-title {
		font-size: 2.2rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		margin-bottom: 0.75rem;
	}

	.intro-desc {
		font-size: 1.05rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
	}

	.intro-desc strong {
		color: var(--text-color);
	}

	.timeline-section {
		margin-top: 0;
	}

	.timeline {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.timeline-year-group {
		position: relative;
	}

	.timeline-year-badge {
		font-size: 1.1rem;
		font-weight: 700;
		font-family: var(--font-mono);
		color: var(--text-muted);
		margin-bottom: 1.25rem;
		padding-left: 0.25rem;
	}

	.timeline-items {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
		padding-left: 1.5rem;
		border-left: 2px solid var(--timeline-line);
		margin-left: 0.5rem;
	}

	.timeline-item {
		position: relative;
		display: flex;
		flex-direction: column;
	}

	.timeline-node {
		position: absolute;
		left: -1.5rem;
		top: 0.35rem;
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: var(--bg-color);
		padding: 3px 0;
	}

	.timeline-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: var(--text-subtle);
		transition: all 0.2s ease;
	}

	.timeline-item:hover .timeline-dot {
		background-color: var(--accent);
		transform: scale(1.4);
		box-shadow: 0 0 8px var(--accent);
	}

	.timeline-content {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.timeline-cover-link {
		width: 100%;
		height: 240px;
		max-height: 260px;
		border-radius: var(--radius-md, 8px);
		overflow: hidden;
		border: 1px solid var(--border-subtle);
		background-color: var(--card-hover);
		display: block;
		box-shadow: var(--shadow-sm);
		margin: 0.25rem 0 0.15rem;
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}

	.timeline-cover-link:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	.timeline-cover-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}

	.timeline-cover-link:hover .timeline-cover-img {
		transform: scale(1.025);
	}

	@media (max-width: 640px) {
		.timeline-cover-link {
			height: 180px;
		}
	}

	.timeline-date {
		font-size: 0.8rem;
		font-family: var(--font-mono);
		color: var(--text-muted);
	}

	.timeline-post-title {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0.2rem 0 0;
		line-height: 1.4;
	}

	.timeline-post-title a {
		color: var(--text-color);
		transition: color 0.15s ease;
	}

	.timeline-post-title a:hover {
		color: var(--accent);
	}

	.timeline-post-desc {
		font-size: 0.9rem;
		color: var(--text-muted);
		margin: 0;
		line-height: 1.5;
	}

	.timeline-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.25rem;
	}

	.timeline-tag {
		font-size: 0.725rem;
		font-family: var(--font-mono);
		color: var(--text-muted);
		background: var(--card-hover);
		padding: 0.1rem 0.45rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border-subtle);
		transition: all 0.2s ease;
	}

	.timeline-tag:hover {
		color: var(--accent);
		border-color: var(--border-color);
	}
</style>
