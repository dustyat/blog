---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import * as readme from '../../README.md';

const Content = readme.Content;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`关于 · ${SITE_TITLE}`}
			description="关于博主 Dusty、技术栈演进与本站的工程构建理念"
		/>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="sr-only">关于 - {SITE_TITLE}</h1>
			<article class="prose content-body">
				<Content />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.content-body {
		padding-top: 0.5rem;
		margin-bottom: 2rem;
	}
</style>
