---
---
<div class="theme-palette" role="group" aria-label="主题配色选择">
	<button
		id="theme-dot-white"
		class="theme-dot dot-white"
		type="button"
		aria-label="默认纯白背景 (#FFFFFF)"
		title="静电白 (#FFFFFF)"
	></button>
	<button
		id="theme-dot-cream"
		class="theme-dot dot-cream"
		type="button"
		aria-label="暖白背景 (#FCFAF8)"
		title="暖白 (#FCFAF8)"
	></button>
	<button
		id="theme-dot-warm"
		class="theme-dot dot-warm"
		type="button"
		aria-label="护眼米黄背景 (#F5F5D5)"
		title="护眼米黄 (#F5F5D5)"
	></button>
	<button
		id="theme-dot-dark"
		class="theme-dot dot-dark"
		type="button"
		aria-label="暗黑模式 (#0D1117)"
		title="暗黑模式 (#0D1117)"
	></button>
</div>

<style>
	.theme-palette {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
	}

	.theme-dot {
		width: 15px;
		height: 15px;
		border-radius: 50%;
		cursor: pointer;
		padding: 0;
		outline: none;
		position: relative;
		border: none;
		transition: opacity 0.2s ease;
	}

	.theme-dot:hover {
		opacity: 0.75;
	}

	/* 1. 默认静电白 (#FFFFFF) */
	.dot-white {
		background-color: #ffffff;
		box-shadow: inset 0 0 0 1px #d0d0d0;
	}

	/* 2. 暖白 (#FCFAF8) */
	.dot-cream {
		background-color: #fcfaf8;
		box-shadow: inset 0 0 0 1px #d5cfc7;
	}

	/* 3. 护眼米黄 (#F5F5D5) */
	.dot-warm {
		background-color: #f5f5d5;
		box-shadow: inset 0 0 0 1px #d0d0a0;
	}

	/* 4. 暗黑夜间 (#0D1117) */
	.dot-dark {
		background-color: #0d1117;
		box-shadow: inset 0 0 0 1px #484f58;
	}
</style>

<script>
	const dotWhiteBtn = document.getElementById('theme-dot-white');
	const dotCreamBtn = document.getElementById('theme-dot-cream');
	const dotWarmBtn = document.getElementById('theme-dot-warm');
	const dotDarkBtn = document.getElementById('theme-dot-dark');

	const setTheme = (theme: string) => {
		document.documentElement.setAttribute('data-theme', theme);
		localStorage.setItem('theme', theme);
	};

	dotWhiteBtn?.addEventListener('click', () => setTheme('white'));
	dotCreamBtn?.addEventListener('click', () => setTheme('cream'));
	dotWarmBtn?.addEventListener('click', () => setTheme('warm'));
	dotDarkBtn?.addEventListener('click', () => setTheme('dark'));
</script>
