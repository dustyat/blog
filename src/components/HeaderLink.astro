---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

// Strip BASE_URL prefix safely if present
const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
let pathname = Astro.url.pathname;
if (baseUrl && pathname.startsWith(baseUrl)) {
	pathname = pathname.slice(baseUrl.length);
}

// Normalize path: ensure leading slash, remove trailing slash
const normalize = (path: string) => {
	const cleaned = path.replace(/\/+$/, '');
	return cleaned.startsWith('/') ? cleaned : '/' + cleaned;
};

const current = normalize(pathname) || '/';
const target = normalize(String(href)) || '/';

const isActive = target === '/' ? current === '/' : (current === target || current.startsWith(target + '/'));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>

<style>
	a {
		position: relative;
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.15rem;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--text-muted);
		transition: color 0.2s ease;
		text-decoration: none;
	}

	a:hover {
		color: var(--text-color);
	}

	a.active {
		color: var(--text-color);
		font-weight: 600;
	}
</style>
