---
---
<div id="search-modal" class="search-modal-backdrop" aria-hidden="true" style="display: none;">
	<div class="search-dialog" role="dialog" aria-modal="true" aria-label="搜索博客文章">
		<div class="search-header">
			<svg class="search-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
			<input
				id="search-input"
				class="search-input"
				type="search"
				placeholder="搜索文章标题、内容、标签... (Esc 关闭)"
				autocomplete="off"
				spellcheck="false"
			/>
			<button id="search-close-btn" class="search-close-btn" type="button" aria-label="关闭搜索">
				<kbd>ESC</kbd>
			</button>
		</div>

		<div id="search-results-container" class="search-results-container">
			<div id="search-placeholder" class="search-hint-message">
				<p>输入关键词、技术栈或标签进行快速检索</p>
				<div class="search-quick-tags">
					<span class="quick-tag-hint">推荐标签：</span>
					<button type="button" class="quick-tag-chip" data-tag="VS Code">#VS Code</button>
					<button type="button" class="quick-tag-chip" data-tag="Python">#Python</button>
					<button type="button" class="quick-tag-chip" data-tag="Astro">#Astro</button>
					<button type="button" class="quick-tag-chip" data-tag="AI/LLM">#AI/LLM</button>
				</div>
			</div>
			<div id="search-empty" class="search-hint-message" style="display: none;">
				<p>未找到匹配的文章</p>
				<span class="search-empty-sub">尝试更换关键词或搜索标签</span>
			</div>
			<ul id="search-results-list" class="search-results-list" role="listbox"></ul>
		</div>

		<div class="search-footer">
			<span class="search-tip"><kbd>↑</kbd> <kbd>↓</kbd> 切换</span>
			<span class="search-tip"><kbd>↵</kbd> 打开</span>
			<span class="search-tip"><kbd>ESC</kbd> 退出</span>
		</div>
	</div>
</div>

<style>
	.search-modal-backdrop {
		position: fixed;
		inset: 0;
		z-index: 999;
		background: rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding: 4.5rem 1rem 2rem;
		animation: modalFadeIn 0.15s ease-out;
	}

	@keyframes modalFadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	.search-dialog {
		width: 100%;
		max-width: 600px;
		background: var(--bg-surface, var(--bg-color));
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md, 12px);
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.18), 0 2px 6px rgba(0, 0, 0, 0.08);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		max-height: 80vh;
	}

	.search-header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.95rem 1.15rem;
		border-bottom: 1px solid var(--border-subtle);
		background: var(--bg-surface, var(--bg-color));
	}

	.search-input-icon {
		color: var(--text-muted);
		flex-shrink: 0;
	}

	.search-input {
		flex: 1;
		border: none;
		outline: none;
		background: transparent;
		font-size: 1.05rem;
		color: var(--text-color);
		font-family: inherit;
	}

	.search-input::placeholder {
		color: var(--text-subtle);
		font-size: 0.95rem;
	}

	/* 清理浏览器原生 search 样式的微瑕 */
	.search-input::-webkit-search-decoration,
	.search-input::-webkit-search-cancel-button,
	.search-input::-webkit-search-results-button,
	.search-input::-webkit-search-results-decoration {
		display: none;
	}

	.search-close-btn {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
		color: var(--text-subtle);
	}

	.search-close-btn kbd,
	.search-tip kbd {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		background: var(--card-hover);
		color: var(--text-muted);
		border: 1px solid var(--border-subtle);
		border-radius: 4px;
		padding: 2px 5px;
		line-height: 1;
	}

	.search-results-container {
		flex: 1;
		overflow-y: auto;
		max-height: 52vh;
		padding: 0.65rem 0.5rem;
	}

	.search-hint-message {
		padding: 2.25rem 1.5rem;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.925rem;
	}

	.search-empty-sub {
		display: block;
		font-size: 0.8rem;
		color: var(--text-subtle);
		margin-top: 0.4rem;
	}

	.search-quick-tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		margin-top: 1rem;
	}

	.quick-tag-hint {
		font-size: 0.8rem;
		color: var(--text-subtle);
	}

	.quick-tag-chip {
		background: var(--card-hover);
		border: 1px solid var(--border-subtle);
		color: var(--text-muted);
		border-radius: var(--radius-sm);
		padding: 0.15rem 0.5rem;
		font-size: 0.75rem;
		font-family: var(--font-mono);
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.quick-tag-chip:hover {
		color: var(--accent);
		border-color: var(--border-color);
	}

	.search-results-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	:global(.search-result-item) {
		display: block;
		padding: 0.75rem 0.95rem;
		border-radius: var(--radius-md, 8px);
		text-decoration: none;
		color: var(--text-color);
		transition: background-color 0.15s ease, border-color 0.15s ease;
		border: 1px solid transparent;
		cursor: pointer;
	}

	:global(.search-result-item.selected),
	:global(.search-result-item:hover) {
		background-color: var(--card-hover);
		border-color: var(--border-subtle);
	}

	:global(.search-result-title) {
		font-size: 0.98rem;
		font-weight: 600;
		color: var(--text-color);
		margin-bottom: 0.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	:global(.search-result-date) {
		font-size: 0.75rem;
		font-family: var(--font-mono);
		color: var(--text-subtle);
		font-weight: 400;
		flex-shrink: 0;
	}

	:global(.search-result-desc) {
		font-size: 0.825rem;
		color: var(--text-muted);
		line-height: 1.45;
		margin: 0 0 0.4rem;
		overflow: hidden;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}

	:global(.search-result-tags) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}

	:global(.search-result-tag) {
		font-size: 0.7rem;
		font-family: var(--font-mono);
		color: var(--text-subtle);
		background: var(--bg-color);
		border: 1px solid var(--border-subtle);
		border-radius: 4px;
		padding: 0.05rem 0.35rem;
	}

	:global(.search-highlight) {
		color: var(--accent);
		font-weight: 700;
		background: transparent;
	}

	.search-footer {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 0.65rem 1.15rem;
		background: var(--card-hover);
		border-top: 1px solid var(--border-subtle);
		font-size: 0.75rem;
		color: var(--text-subtle);
	}

	@media (max-width: 640px) {
		.search-modal-backdrop {
			padding: 1.5rem 0.75rem;
		}
		.search-footer {
			display: none;
		}
	}
</style>

<script>
	interface SearchItem {
		id: string;
		title: string;
		date: string;
		desc: string;
		tags: string[];
		url: string;
	}

	let searchIndex: SearchItem[] | null = null;
	let selectedIndex = -1;
	let currentFilteredItems: SearchItem[] = [];

	const modal = document.getElementById('search-modal') as HTMLElement | null;
	const input = document.getElementById('search-input') as HTMLInputElement | null;
	const closeBtn = document.getElementById('search-close-btn');
	const resultsList = document.getElementById('search-results-list');
	const placeholder = document.getElementById('search-placeholder');
	const empty = document.getElementById('search-empty');

	const loadIndex = async () => {
		if (searchIndex) return searchIndex;
		try {
			const res = await fetch('/search-index.json');
			searchIndex = await res.json();
			return searchIndex;
		} catch (err) {
			console.error('Failed to load search index', err);
			return [];
		}
	};

	// Preload index on idle or button hover
	if (typeof window !== 'undefined') {
		if ('requestIdleCallback' in window) {
			(window as any).requestIdleCallback(() => loadIndex());
		} else {
			setTimeout(loadIndex, 1000);
		}
		document.getElementById('search-btn')?.addEventListener('pointerenter', () => loadIndex(), { once: true });
	}

	const openSearch = async () => {
		const modal = document.getElementById('search-modal') as HTMLElement | null;
		const input = document.getElementById('search-input') as HTMLInputElement | null;
		if (!modal || !input) return;
		modal.style.display = 'flex';
		modal.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
		input.value = '';
		selectedIndex = -1;
		setTimeout(() => input.focus(), 50);
		await loadIndex();
		await renderResults('');
	};

	const closeSearch = () => {
		const modal = document.getElementById('search-modal');
		if (!modal) return;
		modal.style.display = 'none';
		modal.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	};

	const highlightMatch = (text: string, query: string): string => {
		if (!query) return escapeHtml(text);
		const regex = new RegExp(`(${escapeRegex(query)})`, 'gi');
		return escapeHtml(text).replace(regex, '<mark class="search-highlight">$1</mark>');
	};

	const escapeHtml = (str: string): string => {
		return str
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#39;');
	};

	const escapeRegex = (str: string): string => {
		return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
	};

	const renderResults = async (query: string) => {
		const resultsList = document.getElementById('search-results-list');
		const placeholder = document.getElementById('search-placeholder');
		const empty = document.getElementById('search-empty');
		if (!resultsList || !placeholder || !empty) return;

		const trimmed = query.trim().toLowerCase();
		if (!trimmed) {
			placeholder.style.display = 'block';
			empty.style.display = 'none';
			resultsList.innerHTML = '';
			currentFilteredItems = [];
			selectedIndex = -1;
			return;
		}

		if (!searchIndex) {
			await loadIndex();
		}

		placeholder.style.display = 'none';
		const items = (searchIndex || []).filter((item) => {
			const titleMatch = item.title.toLowerCase().includes(trimmed);
			const descMatch = item.desc.toLowerCase().includes(trimmed);
			const tagMatch = item.tags.some(t => t.toLowerCase().includes(trimmed.replace(/^#/, '')));
			return titleMatch || descMatch || tagMatch;
		});

		currentFilteredItems = items;
		selectedIndex = items.length > 0 ? 0 : -1;

		if (items.length === 0) {
			empty.style.display = 'block';
			resultsList.innerHTML = '';
			return;
		}

		empty.style.display = 'none';
		resultsList.innerHTML = items.map((item, idx) => `
			<li role="option" aria-selected="${idx === 0}">
				<a href="${item.url}" class="search-result-item ${idx === 0 ? 'selected' : ''}" data-index="${idx}">
					<div class="search-result-title">
						<span>${highlightMatch(item.title, trimmed)}</span>
						<span class="search-result-date">${item.date}</span>
					</div>
					${item.desc ? `<p class="search-result-desc">${highlightMatch(item.desc, trimmed)}</p>` : ''}
					${item.tags.length > 0 ? `
						<div class="search-result-tags">
							${item.tags.map(t => `<span class="search-result-tag">#${t}</span>`).join('')}
						</div>
					` : ''}
				</a>
			</li>
		`).join('');
	};

	const updateSelection = (newIndex: number) => {
		if (currentFilteredItems.length === 0) return;
		selectedIndex = (newIndex + currentFilteredItems.length) % currentFilteredItems.length;

		const resultsList = document.getElementById('search-results-list');
		const resultItems = resultsList?.querySelectorAll('.search-result-item');
		resultItems?.forEach((el, idx) => {
			el.classList.toggle('selected', idx === selectedIndex);
			if (idx === selectedIndex) {
				(el as HTMLElement).scrollIntoView({ block: 'nearest' });
			}
		});
	};

	// Event Listeners
	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		const modal = document.getElementById('search-modal');
		const input = document.getElementById('search-input') as HTMLInputElement | null;

		if (target.closest('#search-btn')) {
			e.preventDefault();
			openSearch();
		} else if (target === modal || target.closest('#search-close-btn')) {
			closeSearch();
		} else if (target.closest('.quick-tag-chip')) {
			const tag = target.closest('.quick-tag-chip')?.getAttribute('data-tag');
			if (tag && input) {
				input.value = tag;
				renderResults(tag);
				input.focus();
			}
		}
	});

	document.addEventListener('input', (e) => {
		const target = e.target as HTMLInputElement;
		if (target && target.id === 'search-input') {
			renderResults(target.value);
		}
	});

	window.addEventListener('keydown', (e) => {
		const modal = document.getElementById('search-modal');
		const input = document.getElementById('search-input');
		const isCmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
		const isSlash = e.key === '/' && document.activeElement !== input && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '');

		if (isCmdK || isSlash) {
			e.preventDefault();
			if (modal && modal.style.display === 'flex') {
				closeSearch();
			} else {
				openSearch();
			}
			return;
		}

		if (!modal || modal.style.display !== 'flex') return;

		if (e.key === 'Escape') {
			e.preventDefault();
			closeSearch();
		} else if (e.key === 'ArrowDown') {
			e.preventDefault();
			updateSelection(selectedIndex + 1);
		} else if (e.key === 'ArrowUp') {
			e.preventDefault();
			updateSelection(selectedIndex - 1);
		} else if (e.key === 'Enter') {
			if (selectedIndex >= 0 && selectedIndex < currentFilteredItems.length) {
				e.preventDefault();
				window.location.href = currentFilteredItems[selectedIndex].url;
			}
		}
	});
</script>
