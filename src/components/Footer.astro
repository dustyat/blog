---
const today = new Date();
---

<footer class="footer">
	<div class="footer-container">
		<div class="footer-content">
			<!-- 随机语录区域（默认兜底 + 客户端动态随机拉取） -->
			<div id="footer-quote-box" class="footer-quote-box">
				<p id="footer-quote-text" class="footer-motto">“真正的专注不是选择做什么，而是坚决拒绝那 99% 看似不错但无关紧要的事情。”</p>
				<p id="footer-quote-author" class="footer-quote-author">
					—— 引用自 <a href="https://quotes.dustyat.com" target="_blank" rel="noopener noreferrer" class="quote-link">Quotes</a>
				</p>
			</div>

			<div class="footer-meta">
				<span>&copy; {today.getFullYear()} dusty</span>
				<span class="sep">·</span>
				<a href="https://github.com/dustyat/blog" target="_blank" rel="noopener noreferrer">GitHub</a>
				<span class="sep">·</span>
				<a href="/rss.xml">RSS</a>
				<span class="sep">·</span>
				<a href="/llms.txt" target="_blank">llms.txt</a>
			</div>
		</div>

		<button id="back-to-top" class="back-to-top" aria-label="Back to top" title="回到顶部">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
				<path d="m18 15-6-6-6 6"/>
			</svg>
		</button>
	</div>
</footer>

<style>
	.footer {
		margin-top: auto;
		background: var(--bg-surface);
		padding: 0 1.25rem 2.75rem;
		transition: background-color 0.25s ease;
	}

	.footer-container {
		width: 100%;
		max-width: 760px;
		margin: 0 auto;
		padding-top: 2.25rem;
		border-top: 1px solid var(--border-subtle);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		position: relative;
		transition: border-color 0.25s ease;
	}

	.footer-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.35rem;
		width: 100%;
	}

	.footer-quote-box {
		max-width: 620px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
	}

	.footer-motto {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
		font-style: italic;
		color: var(--text-color);
		opacity: 0.88;
		white-space: pre-line;
	}

	.footer-quote-author {
		margin: 0;
		font-size: 0.78rem;
		color: var(--text-muted);
		line-height: 1.4;
	}

	.quote-link {
		color: var(--accent);
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	.quote-link:hover {
		text-decoration: underline;
		opacity: 0.85;
	}

	.footer-meta {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.825rem;
		color: var(--text-muted);
	}

	.footer-meta a {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-meta a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.sep {
		color: var(--border-subtle);
		user-select: none;
	}

	.back-to-top {
		position: absolute;
		right: 0;
		bottom: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 6px;
		border: none;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.back-to-top:hover {
		color: var(--text-color);
		transform: translateY(-2px);
	}

	@media (max-width: 640px) {
		.footer {
			padding: 0 1rem 2.25rem;
		}
		.footer-container {
			padding-top: 1.75rem;
		}
		.back-to-top {
			position: static;
			margin-top: 0.85rem;
		}
	}
</style>

<script>
	// 回到顶部
	document.getElementById('back-to-top')?.addEventListener('click', () => {
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});

	// 从 quotes.dustyat.com 动态随机加载一条名言
	async function fetchRandomQuote() {
		const textEl = document.getElementById('footer-quote-text');
		const authorEl = document.getElementById('footer-quote-author');
		if (!textEl || !authorEl) return;

		try {
			const res = await fetch('https://quotes.dustyat.com/api/memos.json');
			if (!res.ok) return;
			const data = await res.json();
			if (!Array.isArray(data) || data.length === 0) return;

			// 随机选择一条
			const randomItem = data[Math.floor(Math.random() * data.length)];
			if (!randomItem || !randomItem.content) return;

			// 去除 markdown 粗体标记等格式化字符，并将过大空行缩减为紧凑优雅的自然换行
			const cleanText = randomItem.content
				.trim()
				.replace(/\*\*(.*?)\*\*/g, '$1')
				.replace(/\n\s*\n+/g, '\n');
			textEl.innerText = `“${cleanText}”`;

			const sourcePart = randomItem.source ? `${randomItem.source} · ` : '';
			authorEl.innerHTML = `—— ${sourcePart}引用自 <a href="https://quotes.dustyat.com" target="_blank" rel="noopener noreferrer" class="quote-link">Quotes</a>`;
		} catch (err) {
			// 保持默认语句展示
		}
	}

	fetchRandomQuote();
</script>
