---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchModal from './SearchModal.astro';
import { SITE_TITLE } from '../consts';
---

<header class="header">
	<nav class="nav-container">
		<a href="/" class="brand-link" aria-label="返回首页">
			<img src="/favicon.svg" alt="" class="brand-icon" width="22" height="22" />
			<span class="brand-title">{SITE_TITLE}</span>
		</a>

		<div class="nav-right">
			<div class="nav-links">
				<HeaderLink href="/">文章</HeaderLink>
				<HeaderLink href="/about/">关于</HeaderLink>
			</div>

			<button id="search-btn" class="nav-search-btn" type="button" aria-label="搜索 (Ctrl+K)" title="搜索文章 (Ctrl+K / ⌘K)">
				<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<span class="search-kbd-pill">⌘K</span>
			</button>

			<div class="nav-actions">
				<ThemeToggle />
			</div>
		</div>
	</nav>
</header>
<SearchModal />

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		background: var(--header-bg);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		padding: 0 1.25rem;
		transition: background-color 0.25s ease;
	}

	.nav-container {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		max-width: 760px;
		margin: 0 auto;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--border-subtle);
		transition: border-color 0.25s ease;
	}

	.brand-link {
		display: inline-flex;
		flex-direction: row;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--text-color);
		transition: opacity 0.2s ease;
		flex-shrink: 0;
	}

	.brand-link:hover {
		opacity: 0.8;
		text-decoration: none;
	}

	.brand-icon {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		display: inline-block;
		flex-shrink: 0;
		vertical-align: middle;
	}

	.brand-title {
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--text-color);
		white-space: nowrap;
		line-height: 1;
	}

	.nav-right {
		display: inline-flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: center;
		gap: 1.4rem;
		flex-shrink: 0;
	}

	.nav-links {
		display: inline-flex;
		flex-direction: row;
		align-items: center;
		gap: 1.25rem;
	}

	.nav-actions {
		display: inline-flex;
		align-items: center;
	}

	@media (max-width: 640px) {
		.header {
			padding: 0 0.85rem;
		}
		.nav-container {
			padding: 0.65rem 0;
			gap: 1.25rem;
		}
		.brand-icon {
			width: 19px;
			height: 19px;
		}
		.brand-title {
			font-size: 0.95rem;
		}
		.nav-right {
			gap: 0.85rem;
		}
		.nav-links {
			gap: 0.75rem;
		}
	}

	@media (max-width: 420px) {
		.header {
			padding: 0 0.75rem;
		}
		.nav-container {
			gap: 1rem;
		}
		.brand-title {
			font-size: 0.9rem;
		}
		.nav-right {
			gap: 0.65rem;
		}
		.nav-links {
			gap: 0.6rem;
		}
	}
</style>
