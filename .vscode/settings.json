{
  // 开启 VS Code 原生粘贴图片自动落盘功能
  "markdown.editor.filePaste.enabled": "smart",
  "markdown.editor.filePaste.copyIntoWorkspace": "mediaFiles",
  "markdown.editor.drop.copyIntoWorkspace": "mediaFiles",

  // 截图粘贴时，自动将图片命名包含文章名（${documentBaseName}）并统一归类
  "markdown.copyFiles.destination": {
    "/src/content/blog/**": "${documentWorkspaceFolder}/src/content/blog/attachments/${documentBaseName}/${documentBaseName}-${fileName}",
    "**/*": "${documentWorkspaceFolder}/attachments/${documentBaseName}/${documentBaseName}-${fileName}"
  },

  // 粘贴网址时智能转为 Markdown 超链接
  "markdown.editor.pasteUrlAsFormattedLink.enabled": "smart",

  // Python 静态类型分析与模块导入路径解析
  "python.analysis.extraPaths": [
    "./scripts"
  ],

  // 开启 Tab 键自动展开代码片段（输入 post 按 Tab 即可直接展开）
  "editor.tabCompletion": "on",
  "editor.snippetSuggestions": "top",

  // 开启 Markdown 中的自动补全提示浮窗
  "[markdown]": {
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "off"
    }
  }
}
